# Touches a marker outside the project, undone by its own compensation.
pack { "./out" }
stick flag = "../nested-cig-marker/flag"
burn (s) {
  s.flag = flag
  proc.run("touch", [flag], {check: true})
} unburn {
  proc.run("rm", ["-f", s.flag], {check: true})
}
exhale "touched ${flag}"
