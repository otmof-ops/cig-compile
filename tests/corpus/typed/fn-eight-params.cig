# Eight-parameter int function: cig-native's MAX_ARGS is 8, so this is
# the widest row the native code can carry.
pull sum8(a, b, c, d, e, f, g, h) {
  snuff a + b + c + d + e + f + g + h
}

exhale sum8(1, 2, 3, 4, 5, 6, 7, 8)
exhale sum8(-1, -2, -3, -4, -5, -6, -7, -8)
exhale sum8(0, 0, 0, 0, 0, 0, 0, 0)
