# `for i in a..b` with the range wider than 10,000,000 fails with E512.
# Caught, then uncaught in a later run from a one-liner script elsewhere.
pull count(a, b) {
  roll n = 0
  for _i in a..b {
    n += 1
    if n > 5 {
      break
    }
  }
  snuff n
}

exhale count(0, 10)
try {
  exhale count(0, 10000001)
} ashtray e {
  exhale "caught", e.kind, e.message
}
try {
  exhale count(-5000001, 5000001)
} ashtray e {
  exhale "caught", e.kind, e.message
}
