cir 1 "demo.cig"
func @1 greet($2:name!) pull requires_burn {                 @1:1
  step                                                       @2:3
  %0 = const "out.txt"                                       @2:17
  %1 = const "hi "                                           @2:28
  %2 = load $2:name!                                         @2:36
  %3 = bin + %1, %2                                          @2:28
  %4 = burn.op write fs.write_text(%0, %3)                   @2:3
  %5 = const null                                            @1:1
  ret %5                                                     @1:1
}
func @0() main {                                             @1:1
  %0 = closure @1                                            @1:1
  decl $0:greet %0                                           @1:1
  step                                                       @4:1
  %1 = const 0                                               @4:10
  decl $1:n! %1                                              @4:1
  step                                                       @5:1
  %2 = const "demo"                                          @5:7
  burn.begin r1 normal label=%2 {                            @5:1
    step                                                     @6:3
    %3 = const "a"                                           @6:9
    %4 = call.user @1(%3)                                    @6:3
    step                                                     @7:3
    %5 = const 1                                             @7:8
    %6 = load $1:n!                                          @7:3
    %7 = bin + %6, %5                                        @7:3
    store $1:n! %7                                           @7:3
  } burn.end
  step                                                       @9:1
  %8 = load $1:n!                                            @9:8
  exhale %8                                                  @9:1
}
